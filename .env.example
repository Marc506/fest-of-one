# SQLite 文件（web 与 worker 共用）
DATABASE_URL=file:./data/fest.db

# Auth.js v5 —— `npx auth secret` 或 `openssl rand -base64 33`
AUTH_SECRET=
# Google OAuth（登录 + 之后增量授权 Google Calendar）
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# 本地开发：访问 /api/auth/dev 以 dev@local 直接登录（生产务必为 0）
DEV_LOGIN=1

# Claude API（策展引擎 / 画像备忘）
ANTHROPIC_API_KEY=
# 服务端 refusal fallback（beta server-side-fallback-2026-07-01），默认关
LLM_ENABLE_FALLBACKS=0

# TMDB v3 Read Access Token（Bearer）
TMDB_READ_TOKEN=

# 32 字节 base64，用于 AES-256-GCM 加密豆瓣 Cookie —— `openssl rand -base64 32`
APP_ENCRYPTION_KEY=

# 对外地址（日历事件 URL、webcal 链接）
APP_BASE_URL=http://localhost:3000
