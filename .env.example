# SQLite 文件（web 与 worker 共用）
DATABASE_URL=file:./data/fest.db

# Auth.js v5 —— `npx auth secret` 或 `openssl rand -base64 33`
AUTH_SECRET=
# Google OAuth（登录 + 之后增量授权 Google Calendar）
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# 本地开发：访问 /api/auth/dev 以 dev@local 直接登录（生产务必为 0）
DEV_LOGIN=1

# Claude API（策展引擎 / 画像备忘）
ANTHROPIC_API_KEY=
# 服务端 refusal fallback（beta server-side-fallback-2026-07-01），默认关
LLM_ENABLE_FALLBACKS=0

# TMDB v3 Read Access Token（Bearer）
TMDB_READ_TOKEN=

# 32 字节 base64，用于 AES-256-GCM 加密豆瓣 Cookie —— `openssl rand -base64 32`
APP_ENCRYPTION_KEY=

# 对外地址（日历事件 URL、webcal 链接）
APP_BASE_URL=http://localhost:3000

# 豆瓣条目先查 Wikidata 拿 TMDB / IMDb 编号与年份（只发豆瓣条目 id）。设为 0 关闭
# WIKIDATA_LOOKUP=1

# 出站代理（中国大陆访问 TMDB / Claude API 需要；Node 不读系统代理）。例：Clash 默认 http://127.0.0.1:7890
# HTTPS_PROXY=

# ── 仅开发 / 演示（生产不要设）──
# 离线片目代替 TMDB：先 `pnpm tsx scripts/seed-fixtures.ts`，再设 TMDB_FIXTURE_CATALOG=data/fixtures/catalog.json
# TMDB_FIXTURE_CATALOG=
# LLM 离线桩 / 录制回放：mock | replay
# LLM_TRANSPORT=

# ── 成本对比测试（默认即 CLAUDE.md 约定；只在想比较时设，或用 pnpm curate 的 --model / --effort / --ttl 只影响一次）──
# CLAUDE_MODEL=claude-sonnet-5-5     # 默认 claude-opus-5-5
# CURATION_EFFORT=medium             # 构思与审查共用，默认 high
# LLM_CACHE_TTL=5m                   # 默认 1h；5m 写入价 1.25× 而非 2×，但隔 5 分钟以上「换一个」读不到缓存
